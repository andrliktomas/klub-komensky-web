---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MapaCest from '../components/MapaCest.astro';
import Obrazek from '../components/Obrazek.astro';
import galerie from '../data/galerie.json';
import { site, zapisy, materialy, cenik, ohlasy, partneri, pocetClenu, datum, pripona } from '../data/site';

const vsechnyAkce = (await getCollection('akce')).sort((a, b) => +a.data.od - +b.data.od);
const cesty = vsechnyAkce
  .filter((a) => a.data.mapa)
  .map((a, i) => ({
    n: i + 1,
    popisek: a.data.mapa!.popisek,
    lat: a.data.mapa!.lat,
    lon: a.data.mapa!.lon,
    rok: a.data.od.getUTCFullYear(),
    zeme: a.data.zeme,
    href: `/akce/${a.id}/`,
  }));

const dnes = new Date();
const nadchazejici = vsechnyAkce.filter((a) => +(a.data.do ?? a.data.od) >= +dnes);
const probehle = [...vsechnyAkce].reverse();
const jeNadchazejici = nadchazejici.length > 0;
const hlavni = nadchazejici[0] ?? probehle[0];

const album = (slug?: string) => (slug ? galerie.alba.find((a) => a.slug === slug) : undefined);
const titulniFoto = (slug?: string) => {
  const a = album(slug);
  return a && a.fotky.length ? `/fotky/${a.fotky[0].cil}` : undefined;
};

// Čísla o klubu se počítají z obsahu webu, aby nezastarala. Počet členů klub doplní.
const prvniRok = vsechnyAkce[0].data.od.getUTCFullYear();
const cisla: { popis: string; hodnota: string | null }[] = [
  { popis: 'Let činnosti', hodnota: String(dnes.getUTCFullYear() - prvniRok) },
  { popis: 'Navštívených zemí', hodnota: String(new Set(vsechnyAkce.map((a) => a.data.zeme).filter(Boolean)).size) },
  { popis: 'Uskutečněných akcí', hodnota: String(vsechnyAkce.length) },
  { popis: 'Členů', hodnota: pocetClenu === null ? null : String(pocetClenu) },
];

const fotoPruh = galerie.alba
  .filter((a) => a.slug !== hlavni.data.album)
  .slice(0, 4)
  .map((a) => ({
    src: a.fotky.length ? `/fotky/${a.fotky[0].cil}` : undefined,
    popis: `${a.nazev} ${a.rok}`,
    href: `/fotogalerie/#${a.slug}`,
  }));

const zpravy = probehle.filter((a) => a.data.typ === 'Zahraniční exkurze' && a.id !== hlavni.id).slice(0, 3);

const aktuality = (await getCollection('aktuality')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);

const kalendar = [
  { kdy: 'Jaro', co: 'Zahraniční exkurze', pozn: '5–6 dní, akreditace MŠMT' },
  { kdy: 'Podzim', co: 'Seminář pro vedení škol', pozn: 'Brno, jednodenní' },
  { kdy: 'Prosinec', co: 'Valná hromada a vánoční posezení', pozn: 'Brno' },
  { kdy: 'Průběžně', co: 'Sdílení materiálů do výuky', pozn: 'online' },
];

// Dokud klub nedodá ohlasy a loga partnerů, drží sekce tvar prázdnými místy.
const ohlasyKZobrazeni = ohlasy.length ? ohlasy : Array.from({ length: 3 }, () => null);
const partneriKZobrazeni = partneri.length ? partneri : Array.from({ length: 4 }, () => null);

const klic = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<Base>
  <section class="uvod na-tmavem">
    <div class="obal uvod-mrizka">
      <div class="uvod-text">
        <h1 class="udaj">Klub Komenský – sdružení pracovníků školství z Brna a okolí</h1>
        <blockquote>
          <p>{site.citat}</p>
          <footer class="udaj">Jan Amos Komenský</footer>
        </blockquote>
        <p class="uvod-popis">
          Jezdíme se učit do škol po celé Evropě, pořádáme semináře pro vedení škol
          a držíme při sobě – v profesi i mezi lidmi.
        </p>
        <div class="tlacitka">
          <a class="tlacitko tlacitko-plne" href="#akce">Prohlédnout akce klubu</a>
          <a class="tlacitko tlacitko-obrys" href="#clenstvi">Stát se členem</a>
        </div>
      </div>
      <div class="uvod-mapa">
        <MapaCest cile={cesty} />
      </div>
    </div>

    <div class="obal">
      <dl class="cisla">
        {cisla.map((c) => (
          <div>
            <dt>{c.popis}</dt>
            <dd>{c.hodnota ?? <span class="doplnit">doplnit</span>}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="sekce" id="akce">
    <div class="obal">
      <div class="nadpis-sekce">
        <h2>{jeNadchazejici ? 'Připravujeme' : 'Naposledy jsme byli'}</h2>
        <a class="odkaz-dal" href="/akce/">Všechny akce a zprávy z cest</a>
      </div>

      <div class="akce-mrizka">
        <a class="karta" href={`/akce/${hlavni.id}/`}>
          <Obrazek
            src={titulniFoto(hlavni.data.album)}
            alt={`${hlavni.data.title} – fotografie z cesty`}
            popis="Fotografie z poslední cesty – 1200 × 800 px"
            pomer="3 / 2"
          />
          <p class="udaj">{hlavni.data.terminText} · {hlavni.data.typ}</p>
          <h3>{hlavni.data.title}</h3>
          <p class="perex">{hlavni.data.perex}</p>
          <p class="dal">{jeNadchazejici ? 'Program a přihláška' : 'Číst zprávu z cesty'}</p>
        </a>

        <div class="rok">
          <h3>Rok v klubu</h3>
          <p class="perex">
            Termíny upřesňujeme vždy s předstihem, aby se s nimi dalo počítat v rozpočtu školy.
          </p>
          <ul>
            {kalendar.map((k) => (
              <li>
                <span class="udaj">{k.kdy}</span>
                <span>{k.co}<span class="udaj">{k.pozn}</span></span>
              </li>
            ))}
          </ul>
          <p class="udaj pozn">
            Exkurze jsou akreditované MŠMT v rámci DVPP jako program{' '}
            <em>„Nové trendy ve vedení škol a školských zařízení“</em>, č. j. 21996/2013-1-504 –
            účast lze hradit z prostředků školy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sekce sekce-vyssi">
    <div class="obal">
      <div class="nadpis-sekce">
        <h2>Ze škol, kde jsme byli</h2>
        <a class="odkaz-dal" href="/fotogalerie/">Fotogalerie – {galerie.alba.length} alb</a>
      </div>
      <div class="pruh">
        {fotoPruh.map((f) => (
          <figure>
            <a href={f.href}>
              <Obrazek src={f.src} alt={f.popis} popis={`${f.popis} – 800 × 600 px`} />
            </a>
            <figcaption class="udaj">{f.popis}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sekce">
    <div class="obal">
      <div class="nadpis-sekce">
        <div>
          <h2>Co jsme se dozvěděli</h2>
          <p class="perex sirsi">
            Zprávy z cest jako čtení o školství jinde – srovnání, která se hodí i těm, kdo s námi nejeli.
          </p>
        </div>
        <a class="odkaz-dal" href="/akce/">Všechny zprávy</a>
      </div>
      <div class="zpravy">
        {zpravy.map((z) => (
          <a class="karta" href={`/akce/${z.id}/`}>
            <Obrazek
              src={titulniFoto(z.data.album)}
              alt={`${z.data.title} – fotografie`}
              popis={`Ilustrace ke zprávě (${z.data.zeme ?? z.data.misto}) – 900 × 600 px`}
              pomer="3 / 2"
            />
            <p class="udaj">{z.data.zeme ?? z.data.misto}, {z.data.od.getUTCFullYear()} · zpráva z cesty</p>
            <h3>{z.data.title}</h3>
            <p class="perex">{z.data.perex}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sekce na-tmavem ohlasy">
    <div class="obal">
      <h2 class="nadpis-maly">Co si účastníci odnesli</h2>
      <div class="ohlasy-mrizka">
        {ohlasyKZobrazeni.map((o) => (
          <blockquote>
            {o ? (
              <>
                <p>„{o.text}“</p>
                <footer class="udaj">{o.kdo}</footer>
              </>
            ) : (
              <>
                <p class="prazdne">
                  Místo pro ohlas účastníka. Pošlete nám citaci a to, jak má být podepsaná
                  (funkce a škola stačí) – doplníme ji sem.
                </p>
                <footer><span class="doplnit">doplnit</span></footer>
              </>
            )}
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="sekce" id="aktuality">
    <div class="obal">
      <div class="nadpis-sekce">
        <h2>Aktuality</h2>
        <a class="odkaz-dal" href="/aktuality/">Všechny aktuality</a>
      </div>
      <ul class="radky">
        {aktuality.map((n) => (
          <li>
            <a class="radek" href={`/aktuality/${n.id}/`}>
              <time class="udaj" datetime={n.data.date.toISOString().slice(0, 10)}>{datum(n.data.date)}</time>
              <span>
                <h3>{n.data.title}</h3>
                <p>{n.data.perex}</p>
              </span>
              <span class="udaj konec">{n.data.rubrika}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sekce sekce-vyssi">
    <div class="obal dvoje">
      <div>
        <div class="nadpis-sekce maly">
          <h2>Zápisy z jednání</h2>
          <a class="odkaz-dal" href="/dokumenty/#zapisy">Všechny od roku {zapisy[zapisy.length - 1].rok}</a>
        </div>
        <ul class="soubory">
          {zapisy.slice(0, 3).map((z) => (
            <li>
              <a href={`/soubory/${z.soubor}`} download>
                <span class="jmeno"><span class="udaj rok-zapisu">{z.rok}</span>{z.nazev}</span>
                <span class="udaj typ">{pripona(z.soubor)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="nadpis-sekce maly">
          <h2>Materiály do výuky</h2>
          <a class="odkaz-dal" href="/materialy/">Všechny materiály</a>
        </div>
        <p class="perex">
          Přípravy a úkoly, které členové sdílejí pro kolegy z mateřských a základních škol.
          Volně ke stažení.
        </p>
        <ul class="soubory">
          {materialy.map((m) => (
            <li>
              <a href={`/soubory/${m.soubor}`} download>
                <span class="jmeno">{m.nazev}</span>
                <span class="udaj typ">{pripona(m.soubor)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sekce" id="clenstvi">
    <div class="obal dvoje">
      <div>
        <h2>Přidejte se k nám</h2>
        <p class="velky">
          Akcí se můžete účastnit i jako nečlenové. Členové mají semináře a exkurze levnější
          a hlasují na valné hromadě.
        </p>
        <dl class="cenik">
          {cenik.map((c) => (
            <div>
              <dt>{c.co}<span class="udaj">{c.pozn}</span></dt>
              <dd>{c.cena ?? <span class="doplnit">doplnit cenu</span>}</dd>
            </div>
          ))}
        </dl>
        <p class="udaj pozn">
          Stanovy a přihláška ke stažení jsou v sekci <a href="/dokumenty/#clenstvi">Dokumenty</a>.
        </p>
      </div>

      <form
        class="prihlaska"
        method="post"
        action={klic ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`}
        enctype={klic ? undefined : 'text/plain'}
        data-web3={klic ? '' : undefined}
      >
        <h3>Přihláška online</h3>
        <p class="perex">Vyplňte, my se ozveme s potvrzením a údaji k platbě.</p>
        {klic && <input type="hidden" name="access_key" value={klic} />}
        {klic && <input type="hidden" name="subject" value="Přihláška ke členství z webu" />}
        <input type="checkbox" name="botcheck" class="skryte" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label for="p-jmeno">Jméno a příjmení, titul</label>
        <input id="p-jmeno" name="name" type="text" autocomplete="name" required />

        <label for="p-email">E-mail</label>
        <input id="p-email" name="email" type="email" autocomplete="email" required />

        <label for="p-skola">Škola / působiště</label>
        <input id="p-skola" name="skola" type="text" autocomplete="organization" />

        <label class="souhlas">
          <input type="checkbox" name="novinky" value="ano" checked />
          Chci dostávat e-mailem pozvánky na akce a nové zprávy z cest (několikrát do roka).
        </label>

        <div class="odeslat">
          <button class="tlacitko tlacitko-plne" type="submit">Odeslat přihlášku</button>
          <a class="odkaz-dal" href="/kontakt/#odber">Jen odběr novinek</a>
        </div>
        <p class="stav udaj" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="sekce sekce-vyssi partneri">
    <div class="obal">
      <h2 class="nadpis-maly tmavy">Spolupracujeme</h2>
      <ul>
        {partneriKZobrazeni.map((p) => (
          <li>
            <Obrazek
              src={p?.logo ? `/obrazky/partneri/${p.logo}` : undefined}
              alt={p ? `${p.nazev} – logo` : ''}
              popis="Logo partnera – 480 × 160 px"
              vyska="4.5rem"
            />
            {p ? <span class="udaj">{p.nazev}</span> : <span class="doplnit">doplnit název</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script is:inline>
    (function () {
      var f = document.querySelector('form.prihlaska[data-web3]');
      if (!f) return;
      var stav = f.querySelector('.stav'), b = f.querySelector('button[type=submit]');
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        b.disabled = true;
        stav.textContent = 'Odesíláme přihlášku…';
        fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.success) throw new Error();
            f.reset();
            stav.textContent = 'Přihláška odeslána. Ozveme se vám na uvedený e-mail.';
          })
          .catch(function () {
            stav.textContent = 'Přihlášku se nepodařilo odeslat. Zkuste to znovu, nebo napište přímo na klubkomensky@seznam.cz.';
          })
          .finally(function () { b.disabled = false; });
      });
    })();
  </script>
</Base>

<style>
  /* ── Úvod ──────────────────────────────────────────────── */
  .uvod { padding-block: clamp(2.5rem, 6vw, 5rem) 0; overflow: hidden; }
  .uvod-mrizka { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .uvod h1.udaj { font-family: var(--sans); font-size: 0.95rem; font-weight: 500; letter-spacing: 0.01em; color: var(--mosaz); line-height: 1.4; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  blockquote { margin: 0; position: relative; }
  blockquote p { font-size: clamp(2.35rem, 4.6vw, 4.1rem); line-height: 1.08; letter-spacing: -0.018em; font-style: italic; font-weight: 400; margin: 0; text-wrap: balance; }
  blockquote p::before { content: '„'; position: absolute; left: -0.55em; color: var(--mosaz); }
  blockquote p::after { content: '“'; color: var(--mosaz); }
  blockquote footer { margin-top: 1.4rem; padding-left: 3.2rem; position: relative; color: var(--mosaz); font-size: 0.95rem; }
  blockquote footer::before { content: ''; position: absolute; left: 0; top: 50%; width: 2.4rem; height: 1px; background: var(--mosaz); }
  .uvod-popis { font-size: clamp(1.25rem, 1.8vw, 1.45rem); line-height: 1.5; color: #e6d6c8; max-width: 33rem; margin: clamp(1.8rem, 3vw, 2.6rem) 0 0; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }

  .cisla { margin: clamp(2.5rem, 5vw, 4rem) 0 0; border-top: 1px solid var(--linka); padding-block: 1.8rem clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: 1.5rem 2rem; }
  .cisla dt { font-family: var(--sans); font-size: 0.875rem; color: var(--mosaz); letter-spacing: 0.01em; }
  .cisla dd { margin: 0.3rem 0 0; font-size: clamp(2rem, 3vw, 2.6rem); line-height: 1.05; font-feature-settings: 'lnum'; }

  /* ── Nejbližší akce ────────────────────────────────────── */
  .akce-mrizka { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .karta { display: block; color: inherit; text-decoration: none; }
  .karta .udaj { margin: 1.2rem 0 0.4rem; }
  .karta h3 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); line-height: 1.15; transition: color 0.15s; }
  .karta:hover h3 { color: var(--akcent); }
  .karta .dal { margin: 0.8rem 0 0; font-family: var(--sans); font-size: 1rem; font-weight: 550; color: var(--akcent); }
  .perex { color: var(--text-tlumeny); font-size: 1.15rem; line-height: 1.5; margin: 0.6rem 0 0; }
  .perex.sirsi { max-width: 34rem; margin-top: 0.8rem; }

  .rok { border-top: 2px solid var(--terakota); padding-top: 1.3rem; }
  .rok h3 { margin-bottom: 0.4rem; }
  .rok > .perex { margin: 0 0 1.2rem; }
  .rok ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linka); }
  .rok li { display: grid; grid-template-columns: minmax(7rem, 9rem) 1fr; gap: 1.5rem; padding-block: 0.9rem; border-bottom: 1px solid var(--linka); }
  .rok li > .udaj { padding-top: 0.3rem; }
  .rok li > span:last-child { font-size: 1.2rem; line-height: 1.35; }
  .rok li .udaj { display: block; margin-top: 0.15rem; }
  .pozn { margin: 1.2rem 0 0; line-height: 1.5; }
  .pozn em { font-style: normal; color: var(--text); }

  /* ── Fotografie a zprávy ───────────────────────────────── */
  .pruh { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.2rem; }
  .pruh figure { margin: 0; }
  .pruh figcaption { margin-top: 0.6rem; }
  .zpravy { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .zpravy h3 { font-size: 1.55rem; line-height: 1.2; }

  /* ── Ohlasy ────────────────────────────────────────────── */
  .nadpis-maly { font-family: var(--sans); font-size: 0.95rem; font-weight: 500; color: var(--mosaz); letter-spacing: 0.01em; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .nadpis-maly.tmavy { color: var(--text-tlumeny); font-weight: 600; font-size: 0.875rem; margin-bottom: 1.5rem; }
  .ohlasy-mrizka { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: clamp(2rem, 4vw, 4rem); }
  .ohlasy blockquote { border-top: 1px solid var(--linka); padding-top: 1.4rem; }
  .ohlasy blockquote p { font-size: clamp(1.3rem, 1.8vw, 1.55rem); line-height: 1.4; font-style: italic; margin: 0; }
  .ohlasy blockquote p.prazdne { color: var(--text-tlumeny); }
  .ohlasy blockquote p::before, .ohlasy blockquote p::after { content: none; }
  .ohlasy blockquote footer { margin-top: 1.1rem; padding-left: 0; }
  .ohlasy blockquote footer::before { content: none; }

  /* ── Zápisy, materiály, členství ───────────────────────── */
  .dvoje { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .nadpis-sekce.maly { margin-bottom: 1.5rem; }
  .nadpis-sekce.maly h2 { font-size: clamp(1.7rem, 2.6vw, 2.15rem); }
  .rok-zapisu { display: inline-block; width: 3.6rem; }

  .velky { font-size: clamp(1.4rem, 2.1vw, 1.7rem); line-height: 1.42; margin: 1.4rem 0 0; }
  .cenik { margin: 2rem 0 0; border-top: 1px solid var(--linka); display: grid; }
  .cenik > div { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.2rem 2rem; padding-block: 1rem; border-bottom: 1px solid var(--linka); }
  .cenik dt { font-size: 1.2rem; }
  .cenik dt .udaj { display: block; }
  .cenik dd { margin: 0; font-size: 1.35rem; white-space: nowrap; }

  .prihlaska { background: var(--bg-vyssi); border: 1px solid var(--linka); padding: clamp(1.5rem, 3vw, 2.5rem); display: grid; gap: 0.45rem; }
