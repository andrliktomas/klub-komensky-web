---
import Base from '../layouts/Base.astro';
import Zahlavi from '../components/Zahlavi.astro';
import Prilohy from '../components/Prilohy.astro';
import Obrazek from '../components/Obrazek.astro';
import { site, spravniRada } from '../data/site';

const cinnost = [
  {
    nadpis: 'Zahraniční exkurze',
    text: 'Akreditovaný program „Nové trendy ve vedení škol a školských zařízení“: návštěvy škol, workshopy s jejich vedením a srovnání vzdělávacích systémů – od Daruvaru po Lublaň.',
  },
  {
    nadpis: 'Semináře',
    text: 'Aktuální otázky řízení škol a školských zařízení s lektory z praxe, například k novému občanskému zákoníku nebo zákonu o pedagogických pracovnících.',
  },
  {
    nadpis: 'Setkávání',
    text: 'Valné hromady, vánoční posezení a výroční shromáždění. Zápisy ze všech jednání zveřejňujeme od roku 2012.',
  },
];
---

<Base titulek="O klubu" popis="Kdo jsme, co děláme a kdo Klub Komenský vede. Sdružení pracovníků školství z Brna a okolí.">
  <Zahlavi nadpis="O klubu" uvod="Aktivní sdružení pracovníků školství z Brna a okolí. Podporujeme se navzájem – v profesi i mezi lidmi." />

  <section class="sekce">
    <div class="obal dvoje">
      <h2>Co děláme</h2>
      <div class="proza">
        <p>
          Klub Komenský je aktivní sdružení pracovníků školství z Brna a okolí. Naším cílem je
          zejména vzájemná podpora jak v profesní, tak v lidské oblasti.
        </p>
        <p>
          Pořádáme zahraniční vzdělávací exkurze akreditované MŠMT, během nichž navštěvujeme
          mateřské, základní i střední školy, setkáváme se s jejich vedením i se zástupci školské
          správy a porovnáváme tamní vzdělávací systém s českým. Byli jsme v Chorvatsku, Itálii,
          Francii, Řecku, Polsku, Španělsku a Slovinsku. Doma pořádáme semináře k aktuálním
          otázkám řízení škol.
        </p>
        <p>
          Našich akcí se můžete účastnit i jako nečlenové. <a href="/akce/">Podívejte se, co jsme pořádali</a>.
        </p>
        <p>
          Klub vznikl jako občanské sdružení. Valná hromada později schválila změnu názvu
          na zapsaný spolek (z. s.).
        </p>
      </div>
    </div>

    <div class="obal cinnost">
      {cinnost.map((c) => (
        <div>
          <h3>{c.nadpis}</h3>
          <p>{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sekce sekce-vyssi" id="spravni-rada">
    <div class="obal dvoje">
      <div>
        <h2>Správní rada</h2>
        <p class="pozn">Klub vedou lidé z mateřských a základních škol v Brně a okolí.</p>
      </div>
      <ul class="rada">
        {spravniRada.map((c, i) => (
          <li>
            <Obrazek
              src={`/obrazky/rada/${i + 1}.jpg`}
              alt={`${c.jmeno} – portrét`}
              popis="Portrét 400 × 400 px"
              pomer="1 / 1"
              kruh
            />
            <span class="jmeno">{c.jmeno}</span>
            <span class="udaj">{c.funkce}</span>
            <span class="udaj">{c.pusobiste}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sekce">
    <div class="obal dvoje">
      <h2>Stanovy a údaje o spolku</h2>
      <div>
        <dl class="udaje">
          <div><dt class="udaj">Název</dt><dd>{site.nazev}</dd></div>
          <div><dt class="udaj">IČO</dt><dd>{site.ico}</dd></div>
          <div><dt class="udaj">Datová schránka</dt><dd>{site.datovaSchranka}</dd></div>
          <div><dt class="udaj">E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
        <Prilohy polozky={[
          { nazev: 'Stanovy Klubu Komenský (2015)', soubor: 'stanovy-kk-2015.doc' },
          { nazev: 'Přihláška za člena', soubor: 'prihlaska-clenstvi.doc' },
        ]} />
        <p style="margin-top:1.5rem"><a class="odkaz-dal" href="/dokumenty/#zapisy">Zápisy z valných hromad</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .dvoje { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(1.5rem, 6vw, 6rem); align-items: start; }
  .pozn { color: var(--text-tlumeny); margin-top: 1.2rem; max-width: 22rem; }

  .cinnost { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: clamp(2rem, 4vw, 4rem); margin-top: clamp(3.5rem, 7vw, 6rem); }
  .cinnost > div { border-top: 2px solid var(--terakota); padding-top: 1.3rem; }
  .cinnost h3 { margin-bottom: 0.7rem; }
  .cinnost p { color: var(--text-tlumeny); font-size: 1.15rem; line-height: 1.55; margin: 0; }

  .rada { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr)); gap: 2rem 1.5rem; }
  .rada li { display: grid; gap: 0; }
  .rada li > :global(.obrazek) { width: 7.5rem; margin-bottom: 1rem; }
  .rada .jmeno { font-size: 1.45rem; line-height: 1.2; }
  .rada .udaj:first-of-type { margin-top: 0.3rem; }

  .udaje { margin: 0 0 2.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1.5rem 2rem; max-width: 46rem; }
  .udaje dd { margin: 0.2rem 0 0; font-size: 1.35rem; }
  @media (max-width: 52rem) { .dvoje { grid-template-columns: 1fr; } }
</style>
